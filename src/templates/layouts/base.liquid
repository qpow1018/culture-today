<!doctype html>
<html lang="{{ site.lang | escape }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ pageTitle | escape }} | {{ site.name | escape }}</title>
    <link rel="stylesheet" href="/assets/styles/reset.css">
    <link rel="stylesheet" href="/assets/styles/base.css">
    <link rel="stylesheet" href="/assets/styles/flow.css">
  </head>
  <body>
    <header class="flow-header">
      <a href="/">{{ site.name | escape }}</a>
    </header>
    {% block content %}{% endblock %}
    <footer class="flow-footer">{{ site.name | escape }} · 개발용 테스트 화면</footer>
  </body>
</html>
