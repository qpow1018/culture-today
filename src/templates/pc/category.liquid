{% layout 'layout' %}

{% block content %}
  <style>
/* 페이지 흐름 확인용 스타일. 최종 매체 디자인은 별도로 결정합니다. */
.flow-page {
  width: min(100% - 2rem, 48rem);
  margin-inline: auto;
  padding-block: 1.5rem;
  line-height: 1.7;
  overflow-wrap: anywhere;
  flex: 1;
}

.flow-page h1,
.flow-page h2,
.flow-page h3,
.flow-page p,
.flow-page ul {
  margin-bottom: 1rem;
}

.flow-card {
  margin-block: 1.5rem;
}


.flow-page { width: min(100% - 3rem, 62.5rem); }
  </style>
  <main class="flow-page">
    <h1>{{ category.name | escape }} 기사 목록</h1>
    <p>총 {{ articles.size }}개 기사</p>
    {% for article in articles %}
      {% render 'article-card', article: article %}
    {% else %}
      <p>아직 등록된 기사가 없습니다.</p>
    {% endfor %}
    <a href="/">메인으로 돌아가기</a>
  </main>
{% endblock %}
