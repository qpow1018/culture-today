<!doctype html>
<html lang="{{ site.lang | escape }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ pageTitle | escape }} | {{ site.name | escape }}</title>
    <link rel="stylesheet" href="/assets/styles/reset.css">
    <link rel="stylesheet" href="/assets/styles/base.css">
  </head>
  <body class="page-pc">
    {% render 'header-pc', site: site, categories: categories, currentCategory: currentCategory %}
    {% block content %}{% endblock %}
    {% render 'footer', site: site %}
  </body>
</html>
