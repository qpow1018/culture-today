{% layout 'layout' %}

{% block content %}
  <style>
/* 페이지 흐름 확인용 스타일. 최종 매체 디자인은 별도로 결정합니다. */
.flow-page {
  width: min(100% - 2rem, 48rem);
  margin-inline: auto;
  padding-block: 1.5rem;
  line-height: 1.7;
  overflow-wrap: anywhere;
  flex: 1;
}

.flow-page h1,
.flow-page h2,
.flow-page h3,
.flow-page p,
.flow-page ul {
  margin-bottom: 1rem;
}

.flow-body {
  margin-block: 1.5rem;
}


.flow-page { width: min(100% - 3rem, 62.5rem); }
  </style>
  <main class="flow-page">
    <article>
      <header>
        <a href="/category/{{ category.id | escape }}/">{{ category.name | escape }} 기사 목록</a>
        <h1>{{ article.title | escape }}</h1>
        <p>{{ article.summary | escape }}</p>
        <p>{{ article.author | escape }} · <time datetime="{{ article.publishedAt | escape }}">{{ article.publishedAt | escape }}</time></p>
      </header>
      {% if article.image %}
        <img src="{{ article.image.src | escape }}" alt="{{ article.image.alt | escape }}">
      {% endif %}
      <div class="flow-body">{{ article.bodyHtml }}</div>
    </article>
    <a href="/category/{{ category.id | escape }}/">목록으로 돌아가기</a>
  </main>
{% endblock %}
