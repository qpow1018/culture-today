{% layout 'layout' %}

{% block content %}
<style>
.article-page {
  width: min(100% - 3rem, 62.5rem);
  margin: 2.5rem auto;
  flex: 1;
  overflow-wrap: anywhere;
}
.article-page .article-category { color: var(--color-accent); font-weight: 650; text-decoration: none; }
.article-page h1 { margin-top: 1rem; font-size: 2.5rem; font-weight: 750; line-height: 1.3; letter-spacing: -0.04em; }
.article-page .article-summary { margin-top: 1.25rem; color: var(--color-muted); font-size: 1.125rem; line-height: 1.7; }
.article-page .article-meta { margin-top: 1.5rem; padding-bottom: 1.5rem; border-bottom: 1px solid var(--color-rule); color: var(--color-muted); font-size: 0.875rem; line-height: 1.6; }
.article-page .article-cover { margin-top: 2rem; }
.article-page .article-cover img { display: block; width: 100%; }
.article-page .article-body { margin-block: 2rem; font-size: 1.125rem; line-height: 1.9; }
.article-page .article-body p { margin-block: 1.25rem; }
.article-page .article-body h2 { margin: 2.5rem 0 1rem; font-size: 1.625rem; font-weight: 700; line-height: 1.4; letter-spacing: -0.025em; }
.article-page .article-body h3 { margin: 2rem 0 1rem; font-size: 1.375rem; line-height: 1.5; }
.article-page .article-body ul,
.article-page .article-body ol { margin-block: 1.25rem; padding-left: 1.5rem; }
.article-page .article-body blockquote { margin-block: 1.5rem; padding-left: 1rem; border-left: 3px solid var(--color-accent); color: var(--color-muted); }
.article-page .article-body a { color: var(--color-accent); }
.article-page .article-back { display: inline-block; color: var(--color-accent); }
.article-page .related { margin-top: 3rem; padding-top: 1.5rem; border-top: 1px solid var(--color-rule); }
.article-page .related > h2,
.article-page .popular > h2 { font-size: 1.5rem; font-weight: 750; letter-spacing: -0.03em; }
.article-page .related-grid { display: grid; gap: 1.25rem; margin-top: 1.5rem; }
.article-page .related-image img { display: block; width: 100%; aspect-ratio: 16 / 9; object-fit: cover; }
.article-page .related h3 { margin-top: 0.75rem; font-size: 1.125rem; line-height: 1.5; }
.article-page .related h3 a,
.article-page .popular a { color: var(--color-ink); text-decoration: none; }
.article-page .related-meta { margin-top: 0.75rem; color: var(--color-muted); font-size: 0.75rem; }
.article-page .popular-note { margin-top: 0.5rem; color: var(--color-muted); font-size: 0.75rem; line-height: 1.6; }
.article-page .popular ol { margin-top: 1rem; padding-left: 1.5rem; }
.article-page .popular li { padding: 1rem 0 1rem 0.25rem; border-top: 1px solid var(--color-rule); line-height: 1.6; }
.article-page .popular li::marker { color: var(--color-accent); font-weight: 750; }
.article-page a:hover { text-decoration: underline; }
.article-page a:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 3px; }
.article-page { display: grid; grid-template-columns: minmax(0, 1fr) 15rem; gap: 3rem; align-items: start; }
.article-page .article-main { min-width: 0; }
.article-page .related-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }

</style>

<main class="article-page">
  <div class="article-main">
    <article>
      <header>
        <a class="article-category" href="/category/{{ category.id | escape }}/">{{ category.name | escape }}</a>
        <h1>{{ article.title | escape }}</h1>
        <p class="article-summary">{{ article.summary | escape }}</p>
        <p class="article-meta">{{ article.author | escape }} · <time datetime="{{ article.publishedAt | escape }}">{{ article.publishedAt | escape }}</time></p>
      </header>
      {% if article.image %}
        <figure class="article-cover">
          <img src="{{ article.image.src | escape }}" alt="{{ article.image.alt | escape }}" width="1672" height="941">
        </figure>
      {% endif %}
      <div class="article-body">{{ article.bodyHtml }}</div>
    </article>
    <a class="article-back" href="/category/{{ category.id | escape }}/">목록으로 돌아가기</a>
    {% if relatedArticles.size > 0 %}
      <section class="related" aria-labelledby="related-heading">
        <h2 id="related-heading">관련 기사</h2>
        <div class="related-grid">
          {% for related in relatedArticles %}
            <article>
              {% if related.image %}
                <a class="related-image" href="{{ related.url | escape }}" tabindex="-1" aria-hidden="true">
                  <img src="{{ related.image.src | escape }}" alt="{{ related.image.alt | escape }}" width="1672" height="941" loading="lazy">
                </a>
              {% endif %}
              <h3><a href="{{ related.url | escape }}">{{ related.title | escape }}</a></h3>
              <p class="related-meta"><time datetime="{{ related.publishedAt | escape }}">{{ related.publishedAt | escape }}</time></p>
            </article>
          {% endfor %}
        </div>
      </section>
    {% endif %}
  </div>
  <aside class="popular" aria-labelledby="popular-heading">
    <h2 id="popular-heading">인기 기사</h2>
    <p class="popular-note">샘플 조회수 기준</p>
    <ol>
      {% for popular in popularArticles %}
        <li><a href="{{ popular.url | escape }}" {% if popular.slug == article.slug %}aria-current="page"{% endif %}>{{ popular.title | escape }}</a></li>
      {% endfor %}
    </ol>
  </aside>
</main>
{% endblock %}
