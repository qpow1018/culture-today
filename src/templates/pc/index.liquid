{% layout 'layout' %}

{% block content %}
  <main class="home-page">
    <h1 class="visually-hidden">{{ site.name | escape }}</h1>
    {% render 'featured-articles', featuredArticles: featuredArticles %}
    <div class="flow-page">
    <h2>카테고리 목록</h2>
    <ul>
      {% for category in categories %}
        <li><a href="/category/{{ category.id | escape }}/">{{ category.name | escape }} 기사 목록</a></li>
      {% endfor %}
    </ul>
    <h2>기사 목록</h2>
    {% for article in articles %}
      {% render 'article-card', article: article %}
    {% endfor %}
    </div>
  </main>
  <script src="/assets/scripts/featured-articles.js" defer></script>
{% endblock %}
