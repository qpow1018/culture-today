<style>
.site-header {
  border-bottom: 1px solid var(--color-rule);
}

.site-header .site-header-inner {
  margin-inline: auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.site-header .site-brand {
  color: var(--color-accent);
  font-weight: 750;
  letter-spacing: -0.06em;
  line-height: 1.2;
  text-decoration: none;
  white-space: nowrap;
}

.site-header .site-navigation-list {
  list-style: none;
  padding: 0;
}

.site-header .site-navigation a {
  display: block;
  color: var(--color-ink);
  font-weight: 550;
  text-decoration: none;
}

.site-header .site-navigation a:hover,
.site-header .site-navigation a[aria-current] {
  color: var(--color-accent);
  text-decoration: underline;
  text-underline-offset: 0.4em;
}

.site-header a:focus-visible,
.site-header button:focus-visible {
  outline: 2px solid var(--color-accent);
  outline-offset: 5px;
}

.site-header .site-header-inner {
  width: min(100% - 3rem, 75rem);
  gap: 1rem;
  padding-block: 1.25rem;
}

.site-header .site-brand { font-size: 1.5rem; }

.site-header .menu-toggle {
  display: inline-flex;
  align-items: center;
  gap: 0.375rem;
  min-height: 44px;
  padding: 0.5rem;
  border: 0;
  background: transparent;
  color: var(--color-ink);
  cursor: pointer;
  flex-shrink: 0;
}

.site-header .menu-toggle[hidden],
.site-header .mobile-navigation[hidden] { display: none; }

.site-header .mobile-navigation {
  border-top: 1px solid var(--color-rule);
  padding: 0.75rem 1.5rem 1rem;
}

.site-header .site-navigation a { padding-block: 0.875rem; }
</style>

<header class="site-header" data-mobile-header>
  <div class="site-header-inner">
    <a class="site-brand" href="/">{{ site.name | escape }}</a>
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-navigation" hidden>
      <svg class="menu-toggle-icon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <path d="M4 7h16M4 12h16M4 17h16"/>
      </svg>
      <span>메뉴</span>
    </button>
  </div>
  <nav class="site-navigation mobile-navigation" id="mobile-navigation" aria-label="카테고리">
    <ul class="site-navigation-list">
      {% for category in categories %}
        <li><a href="/category/{{ category.id | escape }}/"{% if currentCategory == category.id %} aria-current="true"{% endif %}>{{ category.name | escape }}</a></li>
      {% endfor %}
    </ul>
  </nav>
</header>
