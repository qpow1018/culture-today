<style>
.recommended {
  width: min(100% - 3rem, 62.5rem);
  margin: 3.5rem auto;
  overflow-wrap: anywhere;
}

.recommended > h2 {
  font-size: 1.75rem;
  font-weight: 750;
  letter-spacing: -0.04em;
}

.recommended-tabs {
  display: flex;
  gap: 1.5rem;
  margin-block: 1rem 1.5rem;
  border-bottom: 1px solid var(--color-rule);
}

.recommended-tabs[hidden],
.recommended-panel[hidden],
.recommended-category[hidden] { display: none; }

.recommended-tabs button {
  min-height: 44px;
  padding: 0.75rem 0;
  border: 0;
  border-bottom: 3px solid transparent;
  background: transparent;
  color: var(--color-muted);
  font-weight: 650;
  cursor: pointer;
}

.recommended-tabs button[aria-selected="true"] {
  border-bottom-color: var(--color-accent);
  color: var(--color-accent);
}

.recommended-grid {
  display: grid;
  gap: 1.5rem;
}

.recommended-card { min-width: 0; }

.recommended-image img {
  display: block;
  width: 100%;
  height: auto;
  aspect-ratio: 16 / 9;
  object-fit: cover;
}

.recommended-card h3 {
  margin-top: 1rem;
  font-size: 1.25rem;
  font-weight: 700;
  line-height: 1.45;
  letter-spacing: -0.025em;
}

.recommended-card h3 a {
  color: var(--color-ink);
  text-decoration: none;
}

.recommended-card h3 a:hover { text-decoration: underline; }

.recommended-summary {
  margin-top: 0.75rem;
  color: var(--color-muted);
  font-size: 0.9375rem;
  line-height: 1.65;
}

.recommended-meta {
  margin-top: 1rem;
  color: var(--color-muted);
  font-size: 0.75rem;
  line-height: 1.6;
}

.recommended-category { margin-block: 1.5rem 1rem; }

.recommended a:focus-visible,
.recommended button:focus-visible {
  outline: 2px solid var(--color-accent);
  outline-offset: 3px;
}

{% if device == 'pc' %}
.recommended-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
{% endif %}

{% if device == 'mobile' %}
.recommended {
  width: calc(100% - 2rem);
  margin-block: 2.5rem;
}

.recommended-tabs {
  justify-content: space-between;
  gap: 0.5rem;
}

.recommended-grid { gap: 2rem; }
{% endif %}
</style>

<section class="recommended" data-recommended aria-labelledby="recommended-heading">
  <h2 id="recommended-heading">추천 기사</h2>
  <div class="recommended-tabs" data-tabs hidden>
    {% for category in recommendedCategories %}
      <button type="button" id="recommended-tab-{{ category.id }}" data-tab aria-controls="recommended-panel-{{ category.id }}">{{ category.name | escape }}</button>
    {% endfor %}
  </div>
  {% for category in recommendedCategories %}
    <div class="recommended-panel" id="recommended-panel-{{ category.id }}" data-panel>
      <h3 class="recommended-category">{{ category.name | escape }}</h3>
      <div class="recommended-grid">
        {% for article in category.articles %}
          <article class="recommended-card">
            {% if article.image %}
              <a class="recommended-image" href="{{ article.url | escape }}" tabindex="-1" aria-hidden="true">
                <img src="{{ article.image.src | escape }}" alt="{{ article.image.alt | escape }}" width="1672" height="941" loading="lazy">
              </a>
            {% endif %}
            <h3><a href="{{ article.url | escape }}">{{ article.title | escape }}</a></h3>
            <p class="recommended-summary">{{ article.summary | escape }}</p>
            <p class="recommended-meta">{{ article.author | escape }} · <time datetime="{{ article.publishedAt | escape }}">{{ article.publishedAt | escape }}</time></p>
          </article>
        {% endfor %}
      </div>
    </div>
  {% endfor %}
</section>
