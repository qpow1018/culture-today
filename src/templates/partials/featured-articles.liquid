<style>
.featured {
  position: relative;
  width: min(100% - 3rem, 62.5rem);
  margin: 2.5rem auto;
}

.featured-slide {
  position: relative;
  min-height: 30rem;
  background: var(--color-ink);
  color: #fff;
}

.featured-slide[hidden],
.featured-controls[hidden] {
  display: none;
}

.featured-image {
  position: absolute;
  inset: 0;
}

.featured-image img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.featured-content {
  position: relative;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  min-height: 30rem;
  padding: 6rem 4.5rem 4.5rem;
  background: linear-gradient(180deg, transparent 15%, rgba(0, 0, 0, 0.85) 100%);
  pointer-events: none;
  overflow-wrap: anywhere;
}

.featured-content a {
  pointer-events: auto;
  color: inherit;
  text-decoration: none;
}

.featured-category {
  align-self: flex-start;
  font-weight: 650;
}

.featured h2 {
  max-width: 42rem;
  margin-top: 0.75rem;
  font-size: 2.5rem;
  font-weight: 750;
  letter-spacing: -0.04em;
  line-height: 1.3;
  text-wrap: balance;
}

.featured-summary {
  max-width: 40rem;
  margin-top: 1rem;
  line-height: 1.7;
}

.featured-meta {
  margin-top: 1rem;
  font-size: 0.875rem;
  line-height: 1.6;
}

.featured-controls button {
  border: 0;
  color: #fff;
  cursor: pointer;
}

.featured-arrow {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  width: 44px;
  height: 44px;
  background: rgba(0, 0, 0, 0.4);
  font-size: 2rem;
  line-height: 1;
}

.featured-arrow[data-previous] { left: 0.75rem; }

.featured-arrow[data-next] { right: 0.75rem; }

.featured-selectors {
  position: absolute;
  bottom: 0.75rem;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
}

.featured-selectors button {
  position: relative;
  width: 44px;
  height: 44px;
  background: transparent;
}

.featured-selectors button::after {
  content: "";
  position: absolute;
  inset: 0;
  margin: auto;
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.45);
}

.featured-selectors button[aria-current]::after { background: #fff; }

.featured a:focus-visible,
.featured button:focus-visible {
  outline: 2px solid #fff;
  outline-offset: 3px;
}

{% if device == 'mobile' %}
.featured {
  width: calc(100% - 2rem);
  margin-block: 1.5rem;
}

.featured-slide,
.featured-content { min-height: 24rem; }

.featured-content { padding: 4rem 2.75rem 4rem; }

.featured h2 { font-size: 1.625rem; }

.featured-summary {
  margin-top: 0.75rem;
  font-size: 0.875rem;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.featured-meta { font-size: 0.75rem; }

.featured-arrow[data-previous] { left: 0; }

.featured-arrow[data-next] { right: 0; }
{% endif %}
</style>

{% if featuredArticles.size > 0 %}
  <section class="featured" data-featured aria-label="주요 기사" aria-roledescription="캐러셀">
    <div class="featured-slides">
      {% for article in featuredArticles %}
        <article class="featured-slide" data-slide role="group" aria-roledescription="슬라이드" aria-label="{{ forloop.index }} / {{ featuredArticles.size }}">
          {% if article.image %}
            <a class="featured-image" href="{{ article.url | escape }}" tabindex="-1" aria-hidden="true">
              <img src="{{ article.image.src | escape }}" alt="{{ article.image.alt | escape }}" width="1672" height="941"{% unless forloop.first %} loading="lazy"{% endunless %}>
            </a>
          {% endif %}
          <div class="featured-content">
            <a class="featured-category" href="/category/{{ article.category | escape }}/">{{ article.categoryName | escape }}</a>
            <h2><a href="{{ article.url | escape }}">{{ article.title | escape }}</a></h2>
            <p class="featured-summary">{{ article.summary | escape }}</p>
            <p class="featured-meta">{{ article.author | escape }} · <time datetime="{{ article.publishedAt | escape }}">{{ article.publishedAt | escape }}</time></p>
          </div>
        </article>
      {% endfor %}
    </div>
    <div class="featured-controls" data-controls hidden>
      <button class="featured-arrow" type="button" data-previous aria-label="이전 주요 기사">‹</button>
      <button class="featured-arrow" type="button" data-next aria-label="다음 주요 기사">›</button>
      <div class="featured-selectors" aria-label="주요 기사 선택">
        {% for article in featuredArticles %}
          <button type="button" data-select="{{ forloop.index0 }}" aria-label="{{ forloop.index }}번 주요 기사: {{ article.title | escape }}"{% if forloop.first %} aria-current="true"{% endif %}></button>
        {% endfor %}
      </div>
    </div>
  </section>
{% endif %}
