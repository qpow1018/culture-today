{% layout 'layout' %}

{% block content %}
  <style>
.visually-hidden {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  overflow: hidden;
  clip-path: inset(50%);
  white-space: nowrap;
}

.home-page {
  flex: 1;
}
  </style>
  <main class="home-page">
    <h1 class="visually-hidden">{{ site.name | escape }}</h1>
    {% render 'featured-articles', device: 'mobile', featuredArticles: featuredArticles %}
    {% render 'recommended-articles', device: 'mobile', recommendedCategories: recommendedCategories %}
    {% render 'latest-articles', device: 'mobile', articles: articles, categories: categories %}
  </main>
  <script src="/assets/scripts/featured-articles.js" defer></script>
  <script src="/assets/scripts/recommended-articles.js" defer></script>
{% endblock %}
