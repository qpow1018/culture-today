{% layout 'layout' %}

{% block content %}
  <main class="flow-page">
    <h1>{{ site.name | escape }}</h1>
    <p>메인 → 목록 → 상세 이동을 확인하는 개발용 화면입니다.</p>
    <h2>카테고리 목록</h2>
    <ul>
      {% for category in categories %}
        <li><a href="/category/{{ category.id | escape }}/">{{ category.name | escape }} 기사 목록</a></li>
      {% endfor %}
    </ul>
    <h2>테스트 기사</h2>
    {% for article in articles %}
      {% render 'article-card', article: article %}
    {% endfor %}
  </main>
{% endblock %}
